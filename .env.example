# Local development: copy to .env.local.
# Vercel: add these in Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.

# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://madvertlabs.com

# ── Sanity CMS (site falls back to local placeholder content when unset) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Optional: enables file uploads on /challenge (stored as Sanity assets)
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# ── Booking calendar (LeadConnector / GoHighLevel widget). Default is built in. ──
NEXT_PUBLIC_BOOKING_URL=https://api.madvertlabs.com/widget/booking/pvk8u6OhzYeIizvLDelx

# ── Email (optional, confirmation emails via Resend) ───
RESEND_API_KEY=
EMAIL_FROM="Madvert Labs <hello@madvertlabs.com>"
LEAD_NOTIFICATION_EMAIL=

# ── Spam protection (optional Cloudflare Turnstile) ────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── CRM + automation webhooks (all optional) ───────────
GOHIGHLEVEL_WEBHOOK_URL=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=
N8N_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Analytics ──────────────────────────────────────────
# GTM and GA4 defaults are built in (GTM-MDFSNH4H, G-MNM7Y974JB); set these only to override.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
# true = GA4 is configured inside GTM, so the site does not load GA4 itself (prevents double counting)
NEXT_PUBLIC_GA4_VIA_GTM=false
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Server-side conversions
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
GA4_API_SECRET=

# ── Rate limiting across instances (optional, Upstash Redis REST) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
