# Local development: copy to .env.local (next dev) and/or .dev.vars (npm run preview).
# Cloudflare: NEXT_PUBLIC_* values are BUILD variables (Workers Builds → Build variables).
# Everything else is a RUNTIME value: Worker → Settings → Variables and Secrets (use Secret for keys/tokens).

# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://madvertlabs.com

# ── Sanity CMS (site falls back to local placeholder content when unset) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Optional: enables file uploads on /challenge (stored as Sanity assets)
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# ── Google Calendar booking ────────────────────────────
# OAuth client (Google Cloud console → Credentials → OAuth client ID, type "Web application")
# Authorised redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/calendar/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtained once via /api/calendar/oauth/start?secret=CALENDAR_SETUP_SECRET
GOOGLE_REFRESH_TOKEN=
CALENDAR_SETUP_SECRET=
# Calendar to read availability from and create events in
GOOGLE_CALENDAR_ID=usamaabbasdahri@gmail.com
CALENDAR_OWNER_NAME=Usama Abbas Dahri
# IANA zone the business hours below are written in, e.g. Asia/Karachi or Europe/London (required)
CALENDAR_TIMEZONE=
CALENDAR_MEETING_MINUTES=30
CALENDAR_BUFFER_BEFORE_MINUTES=15
CALENDAR_BUFFER_AFTER_MINUTES=15
# JSON: weekday (0=Sun..6=Sat) → [["HH:MM","HH:MM"], ...] in CALENDAR_TIMEZONE. No default availability is assumed.
CALENDAR_BUSINESS_HOURS=
CALENDAR_MIN_NOTICE_HOURS=12
CALENDAR_BOOKING_WINDOW_DAYS=21

# ── Email (optional, confirmation emails via Resend) ───
RESEND_API_KEY=
EMAIL_FROM="Madvert Labs <hello@madvertlabs.com>"
LEAD_NOTIFICATION_EMAIL=

# ── Spam protection (optional Cloudflare Turnstile) ────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── CRM + automation webhooks (all optional) ───────────
GOHIGHLEVEL_WEBHOOK_URL=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=
N8N_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Analytics (each loads only when set) ───────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
# Server-side conversions
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
GA4_API_SECRET=

# ── Rate limiting across instances (optional, Upstash Redis REST) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
