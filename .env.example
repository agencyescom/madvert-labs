# Local development: copy to .env.local.
# Vercel: add these in Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.

# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://madvertlabs.com

# ── Sanity CMS (site falls back to local placeholder content when unset) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Optional: enables file uploads on /challenge (stored as Sanity assets)
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# ── Booking calendar (LeadConnector / GoHighLevel widget). Default is built in. ──
NEXT_PUBLIC_BOOKING_URL=https://api.madvertlabs.com/widget/booking/pvk8u6OhzYeIizvLDelx

# ── Email (optional, confirmation emails via Resend) ───
RESEND_API_KEY=
EMAIL_FROM="Madvert Labs <hello@madvertlabs.com>"
LEAD_NOTIFICATION_EMAIL=

# ── Spam protection (optional Cloudflare Turnstile) ────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── CRM + automation webhooks (all optional) ───────────
GOHIGHLEVEL_WEBHOOK_URL=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=
N8N_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Analytics ──────────────────────────────────────────
# GTM and GA4 defaults are built in (GTM-MDFSNH4H, G-MNM7Y974JB); set these only to override.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
# true = GA4 is configured inside GTM, so the site does not load GA4 itself (prevents double counting)
NEXT_PUBLIC_GA4_VIA_GTM=false
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Server-side conversions
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
GA4_API_SECRET=

# ── Rate limiting across instances (optional, Upstash Redis REST) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Client Onboarding Portal (Madvert Operations) ──────
# Postgres (Neon, Vercel Postgres, Supabase…). Required in production; tables are created automatically.
# Without it, local development uses a JSON file in ONBOARDING_DATA_DIR (default ./.data).
DATABASE_URL=
DATABASE_POOL_MAX=5
ONBOARDING_DATA_DIR=.data
# 32+ random characters: signs team sessions and short-lived file URLs, encrypts stored link copies.
ONBOARDING_SECRET=
# 32 bytes (hex or base64) for the secure credential vault (AES-256-GCM). e.g. `openssl rand -hex 32`
ONBOARDING_ENCRYPTION_KEY=
# Base URL used in client / delegated links (defaults to NEXT_PUBLIC_SITE_URL)
ONBOARDING_BASE_URL=
# Days an onboarding link stays valid (also editable in Settings)
ONBOARDING_LINK_DAYS=60
# Madvert Operations sign in (/ops). Shared team password + optional allow-list of emails.
OPS_ADMIN_PASSWORD=
OPS_ADMIN_EMAILS=
# Private file storage for uploads (Vercel Blob). Without it, local development stores files on disk.
BLOB_READ_WRITE_TOKEN=
# Google Drive workspace folders (service account). Optional.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Automation events (in addition to the CRM webhooks above)
ONBOARDING_WEBHOOK_URL=
ONBOARDING_WEBHOOK_SECRET=
# GoHighLevel workflow "Appointment booked" → POST /api/onboarding/webhooks/booking with header x-webhook-secret
ONBOARDING_BOOKING_WEBHOOK_SECRET=
# Optional separate kickoff calendar (otherwise NEXT_PUBLIC_BOOKING_URL; editable in Settings)
ONBOARDING_BOOKING_URL=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to /api/onboarding/cron/reminders
CRON_SECRET=
# First defaults for Settings → Company → Integrations (all editable in /ops/settings)
MADVERT_META_PARTNER_ID=977388997110589
MADVERT_GOOGLE_ADS_MANAGER_ID=
MADVERT_GOOGLE_ACCESS_EMAIL=info@madvertlabs.com
MADVERT_WEBSITE_ACCESS_EMAIL=
MADVERT_DNS_ACCESS_EMAIL=
MADVERT_CRM_ACCESS_EMAIL=
MADVERT_SUPPORT_EMAIL=hello@madvertlabs.com
MADVERT_SUPPORT_WHATSAPP=
MADVERT_DEFAULT_ACCOUNT_MANAGER="Usama Abbas Dahri"
MADVERT_DEFAULT_ACCOUNT_MANAGER_EMAIL=
MADVERT_DEFAULT_STRATEGIST="Usama Abbas Dahri"
# Subdomain: serve the portal, Operations and Offer Builder at this host (same Vercel project)
ONBOARDING_HOST=onboarding.madvertlabs.com
# "Create client in CRM" (GoHighLevel private integration token + location; opportunity is optional)
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
ONBOARDING_GHL_PIPELINE_ID=
ONBOARDING_GHL_STAGE_ID=
# White-label app domain for "Open in CRM" links (default https://app.gohighlevel.com)
GHL_APP_BASE=
