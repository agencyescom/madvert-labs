# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.madvertlabs.com/custom-patches

# ── Booking (GoHighLevel) ───────────────────────────────
# Defaults to the Madvert Labs discovery-call calendar; override only to change calendars.
NEXT_PUBLIC_GHL_CALENDAR_URL=https://api.madvertlabs.com/widget/booking/m2v95rY845IT0tQwdbEL
# GHL embed script. Compare with GHL → Calendars → Share → Embed code; change only if yours differs.
NEXT_PUBLIC_GHL_EMBED_SCRIPT=https://api.madvertlabs.com/js/form_embed.js

# ── Form submissions ───────────────────────────────────
# Where the browser posts the application and discovery forms. Defaults:
#   static export (/custom-patches) → /api/apply on the main site (GoHighLevel)
#   local server build              → /api/apply in this project
NEXT_PUBLIC_LEADS_ENDPOINT=

# ── Analytics (all optional; nothing loads when empty) ─
# Defaults to the Madvert Labs pixel 1410121457947973; set to "off" to disable.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# ── Application delivery (server-side; any or all) ─────
# Generic JSON webhook: Zapier / Make / n8n / custom endpoint
APPLICATION_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header
APPLICATION_WEBHOOK_SECRET=
# GoHighLevel inbound webhook (Automation → Workflow → Inbound Webhook trigger)
GHL_WEBHOOK_URL=
# HubSpot Forms API (no private token needed)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# ── Qualification (optional overrides) ─────────────────
# Score (0–100) at or above which the booking calendar is shown.
NEXT_PUBLIC_QUALIFY_THRESHOLD=60
